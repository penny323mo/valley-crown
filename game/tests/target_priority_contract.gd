extends SceneTree
const Priority=preload("res://scripts/target_priority.gd")
var checks=[]
func check(label,ok):
 checks.append({"name":label,"passed":bool(ok)})
 if not ok:push_error(label)
func _initialize():call_deferred("run")
func run():
 var spear={"id":1,"kind":"spearman","category":"unit"};var cavalry={"id":2,"kind":"cavalry","category":"unit"};var archer={"id":3,"kind":"archer","category":"unit"}
 check("spearmen prefer cavalry matchup",Priority.better("spearman","counter",cavalry,spear,2,1))
 check("archers prefer spearman matchup",Priority.better("archer","counter",spear,cavalry,2,1))
 check("cavalry prefer archer matchup",Priority.better("cavalry","counter",archer,spear,2,1))
 check("nearest policy ignores matchup",not Priority.better("spearman","nearest",cavalry,spear,2,1))
 check("equal bonus retains nearest",Priority.better("archer","counter",cavalry,archer,1,2))
 check("equal distance retains stable id tie",Priority.better("scout","counter",spear,cavalry,1,1))
 var g=load("res://main.tscn").instantiate();root.add_child(g);g.set_process(false);g.test_mode=true;g.ai_enabled=false;g._test_reset();g.set_process(false);await process_frame
 var own=g._spawn("archer",0,Vector3(0,0,0),true)
 var near=g._spawn("archer",1,Vector3(1,0,0),true)
 var counter=g._spawn("spearman",1,Vector3(3,0,0),true)
 g._update_vision();g._order_advance([own.id],Vector3(8,0,0),0)
 check("default advance still targets nearest",g._advance_target(own).id==near.id)
 var mode=own.mode;var dest=own.dest;var epoch=own.work_epoch
 g._set_target_policy([own.id],"counter",0)
 check("policy preserves current movement and path epoch",own.mode==mode and own.dest==dest and own.work_epoch==epoch)
 check("advance targets in range counter",g._advance_target(own).id==counter.id)
 counter.pos=Vector3(7,0,0);g._update_vision()
 check("counter does not expand attack range",g._advance_target(own).id==near.id)
 counter.pos=Vector3(3,0,0);g._update_vision();g.visible_cells[0].fill(0);g.visible_cells[0][g._cell_index(near.pos)]=1;g._publish_faction_views()
 check("hidden counter cannot redirect advance",g._advance_target(own).id==near.id)
 g._update_vision();g._set_stance(own,"DEFEND")
 check("defend uses opted counter within anchor bounds",g._stance_target(own).id==counter.id)
 counter.pos=Vector3(3.1,0,0);g._update_vision()
 check("defend preserves three metre pursuit bounds",g._stance_target(own).id==near.id)
 g._order(own,"attack",near.id);g._set_target_policy([own.id],"counter",0)
 check("explicit target is never replaced by policy change",own.target==near.id and own.state=="attack")
 var worker=g._first(0,"villager");g._set_target_policy([worker.id,near.id],"counter",0)
 check("workers and enemy units cannot be configured",not worker.has("target_policy") and not near.has("target_policy"))
 g._publish_faction_views()
 check("policy is only projected to owning faction",g.faction_views[0].records()[own.id].target_policy=="counter" and not g.faction_views[1].records()[own.id].has("target_policy"))
 check("malformed ids rejected without mutation",not g._set_target_policy([own.id,"bad"],"nearest",0) and own.target_policy=="counter")
 g._set_target_policy([own.id],"nearest",0);g._set_stance(own,"STOP")
 check("policy can return to nearest",g._stance_target(own).id==near.id)
 g._set_target_policy([own.id],"counter",0);g._select([own.id]);g._publish_faction_views();g._update_hud()
 check("applied policy is visible in selected HUD",g.selection_detail.text.contains("克制優先 1"))
 var pending=g.commands.size();g.compact_menu.show();g.find_child("TargetPolicy_nearest",true,false).pressed.emit()
 check("army menu policy queues without immediately mutating",g.commands.size()==pending+1 and own.target_policy=="counter" and not g.compact_menu.visible)
 g._tick(0.1)
 check("queued policy commits through normal tick",own.target_policy=="nearest")
 g.queue_free();await process_frame
 var failed=checks.filter(func(c):return not c.passed).size()
 print(JSON.stringify({"suite":"target_priority_contract","checks":checks,"failed":failed,"scope":"Explicit automatic engagement policy, not new units or expanded perception"}));quit(1 if failed else 0)
