extends SceneTree
var checks=[]
func check(label,ok):
 checks.append({"name":label,"passed":bool(ok)})
 if not ok:push_error(label)
func _initialize():call_deferred("run")
func run():
 var g=load("res://main.tscn").instantiate();root.add_child(g);g.set_process(false);g.test_mode=true;g.ai_enabled=false;g._test_reset();g.set_process(false);await process_frame
 var tower=g._spawn("tower",0,Vector3.ZERO,true)
 var near=g._spawn("spearman",1,Vector3(3,0,0),true)
 var ram=g._spawn("siege",1,Vector3(5,0,0),true)
 g._update_vision();g._update_tower(tower)
 check("default tower still selects nearest unit",g.attack_ledger.event(1).target_id==near.id)
 var cooldown=tower.cooldown_ticks;var bank=g.economy.bank_milli(0).duplicate()
 check("visible in range siege can be focused",g._set_tower_focus([tower.id],ram.id,0))
 check("setting focus does not reset cooldown",tower.cooldown_ticks==cooldown)
 g._update_tower(tower)
 check("focused tower respects existing cooldown",g.attack_ledger.next_attack_id()==2)
 tower.cooldown_ticks=0;g._update_tower(tower)
 check("actual next arrow targets selected siege",g.attack_ledger.event(2).target_id==ram.id)
 check("focus cannot change shot damage",g.attack_ledger.event(2).damage==g.Rules.CONTENT.resolve_damage("tower","siege").damage)
 check("focus does not spend resources",bank==g.economy.bank_milli(0))
 var far=g._spawn("cavalry",1,Vector3(15,0,0),true);g._update_vision()
 check("out of range focus rejected preserving old target",not g._set_tower_focus([tower.id],far.id,0) and tower.focus_target==ram.id)
 check("friendly target rejected",not g._set_tower_focus([tower.id],g._first(0,"villager").id,0) and tower.focus_target==ram.id)
 var unbuilt=g._spawn("tower",0,Vector3(-5,0,0),false)
 check("unfinished tower cannot focus",not g._set_tower_focus([unbuilt.id],ram.id,0))
 check("opponent cannot control tower",not g._set_tower_focus([tower.id],near.id,1))
 g._publish_faction_views();g._select([tower.id]);g._update_hud()
 check("selected tower shows focused unit type",g.selection_detail.text.contains("集中射擊 攻城車"))
 ram.pos=Vector3(14,0,0);g._update_vision();tower.cooldown_ticks=0;g._update_tower(tower)
 check("departed target retires lock and resumes automatic fire",not tower.has("focus_target") and g.attack_ledger.event(3).target_id==near.id)
 ram.pos=Vector3(5,0,0);g._update_vision();g._set_tower_focus([tower.id],ram.id,0)
 g.visible_cells[0].fill(0);g._update_tower(tower)
 check("lost visibility retires focus even during cooldown",not tower.has("focus_target"))
 g._update_vision();g._set_tower_focus([tower.id],ram.id,0);g._set_tower_focus([tower.id],-1,0)
 check("explicit auto command clears focus",not tower.has("focus_target"))
 g._set_tower_focus([tower.id],ram.id,0);ram.alive=false;g._update_tower(tower)
 check("dead target clears focus",not tower.has("focus_target"))
 ram.alive=true;g._update_vision();g._select([tower.id]);g.camera_focus=Vector3(3,0,0);g.camera_zoom=15;g._camera_update();g._update_visuals(0);await process_frame
 var screen=g.camera.unproject_position(ram.pos)
 g._tap(screen,true)
 check("selected tower contextual enemy tap queues focus",g.commands.size()==1 and g.commands[0].type=="tower_focus" and g.commands[0].target==ram.id)
 while not g.commands.is_empty():g._execute(g.commands.pop_front())
 check("queued contextual command applies selected target",tower.get("focus_target",-1)==ram.id)
 g._clear_selected_tower_focus()
 check("auto action queues ordinary clear command",g.commands.size()==1 and g.commands[0].type=="tower_focus" and g.commands[0].target==-1)
 while not g.commands.is_empty():g._execute(g.commands.pop_front())
 check("queued clear restores automatic defense",not tower.has("focus_target"))
 g.queue_free();await process_frame
 var failed=checks.filter(func(c):return not c.passed).size()
 print(JSON.stringify({"suite":"tower_focus_contract","checks":checks,"failed":failed,"scope":"Controlled native contextual pointer and normal queued command, not physical phone or natural siege"}));quit(1 if failed else 0)
