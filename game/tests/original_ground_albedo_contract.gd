extends SceneTree
## CPU asset/source recipe contract. Native framebuffer and decoded imported payload evidence is separate.
const World=preload("res://scripts/mature_world_visuals.gd")
const EXPECTED={
 "grass_original_albedo.png":"c4b3f5bc205a9e51faf1226e653943350009a63f31537ba41b7f5d31ba86ee7c",
 "earth_original_albedo.png":"3b3533b517636669321869b6936ae9b6225dc0cfb47fe3994b267fe7bdd75157"}
var checks=[]
func c(n,b):checks.append({"name":n,"passed":bool(b)})
func _initialize():call_deferred("run")
func run():
 var root_path="res://assets/mature/terrain/"
 var provenance=JSON.parse_string(FileAccess.get_file_as_string("res://art/original_ground_albedo/PROVENANCE.json"))
 c("provenance is nonempty dictionary",provenance is Dictionary and not provenance.is_empty())
 if not provenance is Dictionary:provenance={}
 var assets=provenance.get("assets",{})
 for name in EXPECTED:
  var path=root_path+name
  c(name+" exact original PNG hash",FileAccess.get_sha256(path)==EXPECTED[name])
  c(name+" provenance exact hash",assets.get(name,"")==EXPECTED[name])
  var img=Image.new();var result=img.load_png_from_buffer(FileAccess.get_file_as_bytes(path))
  c(name+" CPU PNG decoder succeeds",result==OK)
  c(name+" original1254 square",img.get_size()==Vector2i(1254,1254))
  c(name+" original opaque RGB8",img.get_format()==Image.FORMAT_RGB8 and not img.has_mipmaps())
  var cfg=ConfigFile.new();var err=cfg.load(path+".import")
  c(name+" import recipe loads",err==OK)
  c(name+" texture importer",cfg.get_value("remap","importer","")=="texture")
  c(name+" exact source dependency",cfg.get_value("deps","source_file","")==path)
  c(name+" import limit512",cfg.get_value("params","process/size_limit",0)==512)
  c(name+" full mip generation",cfg.get_value("params","mipmaps/generate",false) and cfg.get_value("params","mipmaps/limit",0)==-1)
  c(name+" lossless not VRAM compressed",cfg.get_value("params","compress/mode",-1)==0 and not cfg.get_value("remap","metadata",{}).get("vram_texture",true))
  c(name+" RGB identity remap",cfg.get_value("params","process/channel_remap/red",-1)==0 and cfg.get_value("params","process/channel_remap/green",-1)==1 and cfg.get_value("params","process/channel_remap/blue",-1)==2)
  c(name+" no normal or premultiply conversion",cfg.get_value("params","compress/normal_map",-1)==0 and not cfg.get_value("params","process/premult_alpha",true))
 var notice=FileAccess.get_file_as_string("res://THIRD_PARTY_NOTICES.txt")
 c("notice discloses original AI material",notice.contains("original AI-generated material assets") and notice.contains("not downloaded third-party CC0 textures"))
 c("notice preserves unrelated donor license",notice.contains("Quaternius Stylized Nature MegaKit Standard. CC0 1.0."))
 c("notice dates generated artwork",notice.contains("November 2026"))
 c("provenance keeps both prompts",provenance.get("prompts",{}).get("grass","").length()>100 and provenance.get("prompts",{}).get("earth","").length()>100)
 c("provenance no new public license",provenance.get("license_note","")=="No new public license granted.")
 c("provenance unedited pixels",provenance.get("raw_pixels_unchanged",false))
 c("provenance exact material tint",provenance.get("shader_tint",[])==[0.60,0.78,0.65])
 var shader=FileAccess.get_file_as_string(root_path+"ground.gdshader")
 c("three total sampler declarations",shader.count("uniform sampler2D ")==3)
 c("three total texture fetches",shader.count("texture(")==3)
 c("grass color mip and repeat",shader.contains("grass_map : source_color, filter_linear_mipmap, repeat_enable"))
 c("earth color mip and repeat",shader.contains("earth_map : source_color, filter_linear_mipmap, repeat_enable"))
 c("corridor linear nonrepeat interface",shader.contains("public_corridor_mask : filter_linear, repeat_disable"))
 c("grass exact two metre sampling and tint",shader.contains("texture(grass_map, p * 0.5).rgb * vec3(0.60, 0.78, 0.65)"))
 c("earth exact two metre sampling",shader.contains("texture(earth_map, p * 0.5).rgb;"))
 c("world anchored coordinates",shader.contains("world_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz") and shader.contains("vec2 p = world_position.xz"))
 c("public corridor sampling unchanged",shader.contains("(p + vec2(float(map_size) * 0.5)) / float(map_size)") and shader.contains("texture(public_corridor_mask, grid_uv).r"))
 c("public settlement inputs retained",shader.contains("uniform vec2 public_home_a") and shader.contains("uniform vec2 public_home_b"))
 c("courtyard derivative antialias retained",shader.contains("fwidth(stone_scale.x)") and shader.contains("smoothstep(0.13, 0.32, pixel_span)"))
 c("roughness and specular retained",shader.contains("ROUGHNESS = 0.95;") and shader.contains("SPECULAR = 0.10;"))
 c("no alpha or depth override",not shader.contains("ALPHA =") and not shader.contains("DEPTH =") and not shader.contains("depth_test_disabled"))
 c("no time or screen sampling",not shader.contains("TIME") and not shader.contains("SCREEN_UV") and not shader.contains("hint_screen_texture"))
 var host=Node3D.new();root.add_child(host)
 var cells={Vector2i(1,2):true,Vector2i(3,4):true};var original=cells.duplicate(true)
 var ground=World.create_ground(host,cells)
 c("one ground child",host.get_child_count()==1 and host.get_child(0)==ground)
 c("ground is one plane surface",ground.mesh is PlaneMesh and ground.mesh.get_surface_count()==1)
 c("ground remains nonshadow caster",ground.cast_shadow==GeometryInstance3D.SHADOW_CASTING_SETTING_OFF)
 c("ground height unchanged",is_equal_approx(ground.position.y,0.006))
 c("ground uses exact shader resource",ground.material_override.shader==World.GROUND_SHADER)
 c("ground binds exact grass asset",ground.material_override.get_shader_parameter("grass_map").resource_path==root_path+"grass_original_albedo.png")
 c("ground binds exact earth asset",ground.material_override.get_shader_parameter("earth_map").resource_path==root_path+"earth_original_albedo.png")
 c("public corridors not mutated",cells==original)
 c("public corridor count retained",ground.get_meta("public_corridor_cells",-1)==2)
 c("presentation only marker retained",ground.get_meta("visual_only",false))
 c("no collision children",ground.get_child_count()==0)
 host.free()
 var failed=checks.filter(func(v):return not v.passed).size()
 print(JSON.stringify({"suite":"original_ground_albedo_contract","checks":checks,"failed":failed,"scope":"CPU original PNG decode/hash, provenance, explicit import recipe, shader interfaces and presentation-node structure. No imported GPU readback, framebuffer secrecy, mathematical seamlessness or mobile performance claim."}))
 quit(1 if failed else 0)
