extends SceneTree
var checks=[]
func check(n,v):
 checks.append({"name":n,"passed":bool(v)})
 if not v:push_error(n)
func _initialize():call_deferred("run")
func fresh(mode="survival"):
 var g=load("res://main.tscn").instantiate();g.skirmish_mode=mode;g.history_path="/tmp/trade-contract-"+str(Time.get_ticks_usec());root.add_child(g);g.set_process(false);g.test_mode=true;return g
func settle():
 for i in 4:await process_frame
func run():
 var g=fresh();await settle();var keep=g._first(0,"town_center")
 var pop=g._population(0);var bank=g.economy.bank_milli(0).duplicate(true);var delivered=g.economy.snapshot().stats[0].delivered.duplicate(true)
 check("six fixed recipes only",g.TradePolicy.RECIPES.size()==6 and g.TradePolicy.kind("iron","wood")=="")
 check("ordinary completed age two keep accepts trade",g._enqueue_trade(keep.id,"wood","food",0))
 var receipt=keep.queue[0].receipt_id
 check("payment immediately takes exact input only",g.economy.bank_milli(0).wood==bank.wood-100000 and g.economy.bank_milli(0).food==bank.food)
 check("trade uses ordinary shared queue metadata",keep.queue.size()==1 and keep.queue[0].trade and not keep.queue[0].research and keep.queue[0].remaining_ticks==300)
 check("trade does not reserve population",g._population(0)==pop)
 check("trade is not recovery military production",g._recovery_view(0).training_items==0)
 for i in 299:g._tick(g.Rules.TICK)
 check("no output before full fifteen seconds",g.economy.bank_milli(0).food==bank.food and keep.queue.size()==1)
 g._tick(g.Rules.TICK)
 check("completed trade yields exact sixty food",keep.queue.is_empty() and g.economy.bank_milli(0).food==bank.food+60000)
 check("trade receipt fulfills once",g.economy.receipt_view(receipt).state=="fulfilled")
 var after=g.economy.bank_milli(0).duplicate(true)
 for i in 4:g._tick(g.Rules.TICK)
 check("later ticks cannot repeat output",g.economy.bank_milli(0)==after)
 check("trade output never counts as delivery",g.economy.snapshot().stats[0].delivered==delivered)
 check("trade economy audit holds",g.economy.audit().ok)
 check("unlisted mineral wood pair rejected without charging",not g._enqueue_trade(keep.id,"iron","wood",0) and g.economy.bank_milli(0)==after)
 check("enemy keep cannot be used",not g._enqueue_trade(g._first(1,"town_center").id,"food","wood",0))
 check("malformed producer id rejected",not g._enqueue_trade(true,"food","wood",0))
 check("boolean team is not a faction",not g._enqueue_trade(keep.id,"food","wood",true))
 check("scout cannot be trade producer",not g._enqueue_trade(g._first(0,"scout").id,"food","wood",0))
 check("iron output recipe accepts",g._enqueue_trade(keep.id,"food","iron",0))
 var refund=g.economy.quote_refund(keep.queue[0].receipt_id,0)
 check("unstarted exact cancellation returns full input",refund.food==100000 and g._cancel_queue_item(keep.id,keep.queue[0].queue_id,refund,0) and g.economy.bank_milli(0)==after)
 check("stone recipe accepts",g._enqueue_trade(keep.id,"food","stone",0))
 g._tick(g.Rules.TICK);refund=g.economy.quote_refund(keep.queue[0].receipt_id,0)
 check("started refund is seventy five food",refund.food==75000)
 var iron=g.economy.bank_milli(0).iron;var stone=g.economy.bank_milli(0).stone
 check("started cancellation yields no output",g._cancel_queue_item(keep.id,keep.queue[0].queue_id,refund,0) and g.economy.bank_milli(0).iron==iron and g.economy.bank_milli(0).stone==stone)
 check("isolated history remains untouched",not FileAccess.file_exists(g.history_path));g.free()
 var young=fresh("standard");await settle()
 check("age one keep cannot trade",not young._enqueue_trade(young._first(0,"town_center").id,"wood","food",0));young.free()
 var full=fresh();await settle();keep=full._first(0,"town_center")
 for i in 3:full._enqueue_train(keep.id,"villager",0)
 for i in 2:full._enqueue_trade(keep.id,"wood","food",0)
 check("units and trades share five slot limit",keep.queue.size()==5)
 var charged=full.economy.bank_milli(0).duplicate(true)
 check("full queue rejects without charging",not full._enqueue_trade(keep.id,"food","wood",0) and full.economy.bank_milli(0)==charged);full.free()
 var crowded=fresh();await settle();var crowd_keep=crowded._first(0,"town_center")
 for entity in crowded.entities:
  if entity.team==0 and entity.kind=="house":crowded._kill(entity)
 check("controlled housing loss creates overpopulation",crowded._population(0)>crowded._capacity(0))
 check("trade can queue without housing capacity",crowded._enqueue_trade(crowd_keep.id,"wood","food",0))
 for i in 300:crowded._tick(crowded.Rules.TICK)
 check("housing loss never stalls trade",crowd_keep.queue.is_empty() and crowded.economy.bank_milli(0).food==210000)
 check("trade is never an exit clearing candidate",crowded._clear_exit_plan(crowd_keep.id).is_empty());crowded.free()
 var doomed=fresh();await settle();var doomed_keep=doomed._first(0,"town_center")
 doomed._enqueue_trade(doomed_keep.id,"food","stone",0);var doomed_receipt=doomed_keep.queue[0].receipt_id
 doomed._kill(doomed_keep)
 check("destroyed keep cancels trade without output",doomed.economy.receipt_view(doomed_receipt).state=="destroyed" and doomed.economy.bank_milli(0).stone==100000 and doomed_keep.queue.is_empty())
 check("destroyed trade audit holds",doomed.economy.audit().ok);doomed.free()
 var continued=fresh();await settle();var home=continued._first(0,"town_center")
 continued._submit("trade",{"building":home.id,"from":"food","to":"iron"})
 for i in 150:continued._tick(continued.Rules.TICK)
 var Codec=load("res://scripts/checkpoint_codec.gd");var Restore=load("res://scripts/checkpoint_restore.gd")
 var captured=Codec.capture(continued)
 check("mid trade capture is valid",not captured.is_empty())
 var encoded=Codec.encode(captured,continued.Rules.BUILD_ID)
 var decoded=Codec.decode(encoded.get("bytes",PackedByteArray()),continued.Rules.BUILD_ID)
 check("mid trade codec roundtrip is valid",decoded.get("ok",false))
 var restored=fresh();await settle()
 check("mid trade restores into detached game",Restore.apply(restored,decoded.get("data",{})))
 restored.paused=false
 check("mid trade restore preserves remaining time",restored._first(0,"town_center").queue.size()==1 and restored._first(0,"town_center").queue[0].remaining_ticks==150)
 for i in 150:
  continued._tick(continued.Rules.TICK);restored._tick(restored.Rules.TICK)
 check("restored trade finishes on same tick",continued.tick_count==restored.tick_count and continued._first(0,"town_center").queue.is_empty() and restored._first(0,"town_center").queue.is_empty())
 check("restored completion grants same exact iron",continued.economy.bank_milli(0)==restored.economy.bank_milli(0) and restored.economy.bank_milli(0).iron==30000)
 check("both continuation audits hold",continued.economy.audit().ok and restored.economy.audit().ok)
 var finished_snapshot=Codec.capture(restored)
 var again=fresh();await settle()
 check("completed trade restores",Restore.apply(again,finished_snapshot));again.paused=false
 var done_bank=again.economy.bank_milli(0).duplicate(true)
 for i in 40:again._tick(again.Rules.TICK)
 check("loading completed trade never grants output twice",again.economy.bank_milli(0)==done_bank and again.economy.audit().ok)
 continued.free();restored.free();again.free()
 for size in [Vector2i(390,844),Vector2i(640,360)]:
  root.size=size;var ui_game=fresh();await settle();keep=ui_game._first(0,"town_center");ui_game._select([keep.id]);await settle();ui_game._open_trade_panel(keep.id);await settle()
  var prefix=str(size)+" "
  check(prefix+"dedicated panel opens without world targeting",ui_game.context_detail_kind=="trade" and ui_game.trade_content.visible and not ui_game.touch_command)
  check(prefix+"panel remains inside viewport",Rect2(Vector2.ZERO,Vector2(size)).encloses(ui_game.context_details.get_global_rect()))
  check(prefix+"six recipes remain in vertical scroll",ui_game.trade_buttons.size()==6 and ui_game.context_details_scroll.vertical_scroll_mode==ScrollContainer.SCROLL_MODE_AUTO)
  for button in ui_game.trade_buttons.values():check(prefix+"button target "+button.name,button.size.y>=44 and button.size.x<=ui_game.context_details.size.x)
  ui_game._request_trade("trade_wood_food");ui_game._request_trade("trade_wood_food")
  check(prefix+"repeated touch queues one pending trade",ui_game.commands.filter(func(c):return c.type=="trade").size()==1)
  ui_game._tick(ui_game.Rules.TICK);ui_game._update_hud();await settle()
  check(prefix+"ordinary command pays and displays pending queue",keep.queue.size()==1 and keep.queue[0].trade and ui_game.queue_label.text.contains("交易"))
  ui_game.paused=true;ui_game._refresh_trade_panel()
  check(prefix+"pause disables every recipe",ui_game.trade_buttons.values().all(func(b):return b.disabled))
  ui_game._toggle_context_details("");await settle()
  check(prefix+"close returns unobstructed normal controls",not ui_game.context_details.visible and not ui_game.touch_command);ui_game.free()
 var failed=checks.filter(func(c):return not c.passed).size()
 var report={"suite":"resource_trade_contract","checks":checks,"failed":failed,"scope":"Fresh local scenarios, normal paid queue and actual mobile panel geometry; no private saves or native screenshot claim"}
 print(JSON.stringify(report));quit(1 if failed else 0)
