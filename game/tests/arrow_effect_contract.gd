extends SceneTree
const Effect=preload("res://scripts/arrow_effect.gd")
var checks=[]
func check(label,ok):
 checks.append({"name":label,"passed":bool(ok)})
 if not ok:push_error(label)
func _initialize():call_deferred("run")
func run():
 var start=Vector3(0,1,0);var finish=Vector3(5,0.8,0)
 var arrow=Effect.make(start,finish,Color.BLUE);root.add_child(arrow)
 check("arrow has shaft head and two fletchings",arrow.get_child_count()==4 and arrow.has_node("Head") and arrow.has_node("Fletching1"))
 check("shaft length independent of attack distance",is_equal_approx(arrow.get_node("Shaft").mesh.height,0.65))
 check("trajectory begins at release point",arrow.position.is_equal_approx(start))
 Effect.present(arrow,Effect.LIFETIME/2)
 check("midflight rises over straight line",arrow.position.y>start.lerp(finish,0.5).y+0.5)
 check("midflight makes forward progress",is_equal_approx(arrow.position.x,2.5))
 Effect.present(arrow,Effect.LIFETIME)
 check("trajectory ends at witnessed endpoint",arrow.position.is_equal_approx(finish))
 check("arrow materials retain depth test",not arrow.get_node("Head").material_override.no_depth_test)
 var g=load("res://main.tscn").instantiate();root.add_child(g);g.set_process(false);g.test_mode=true;g.ai_enabled=false;g._test_reset();g.set_process(false);await process_frame
 var keep=g._first(0,"town_center")
 var archer=g._spawn("archer",0,keep.pos+Vector3(4,0,0),true)
 var target=g._spawn("spearman",1,archer.pos+Vector3(3,0,0),true)
 g._update_vision();g.test_mode=false
 var hp=target.hp;var bank=g.economy.bank_milli(0).duplicate()
 var released=g._release_attack(archer,target)
 check("actual archer release creates witnessed arrow",released.applied and g.attack_effects.size()==1 and g.attack_effects[0].node.name=="WitnessedArrow")
 var cue=g.attack_effects[0];var pose=cue.node.transform
 g._update_attack_effects(0.1,false)
 check("pause freezes arrow pose and age",cue.age==0 and cue.node.transform==pose)
 g._update_attack_effects(0.1,true)
 check("running animation advances arrow",cue.age>0 and cue.node.position!=pose.origin)
 var endpoint=cue.node.get_meta("finish");target.pos+=Vector3(4,0,0)
 g._update_attack_effects(0.01,true)
 check("arrow never tracks moving authority target",cue.node.get_meta("finish")==endpoint)
 check("presentation never settles damage or spends resources",target.hp==hp and g.economy.bank_milli(0)==bank)
 g.visible_cells[0].fill(0);g._update_attack_effects(0,false)
 check("fog revokes arrow while paused",g.attack_effects.is_empty())
 g._attack_effect(archer,target)
 check("unseen endpoint cannot create arrow",g.attack_effects.is_empty())
 g._update_vision();g._attack_effect(archer,target);g._update_attack_effects(1,true)
 check("expired arrows are removed",g.attack_effects.is_empty())
 var tower=g._spawn("tower",0,keep.pos+Vector3(8,0,0),true);g._update_vision();g._attack_effect(tower,target)
 check("tower arrow launches from elevated battlement",g.attack_effects.size()==1 and is_equal_approx(g.attack_effects[0].node.position.y,3.2))
 g.game_over=true;g._update_attack_effects(0,false)
 check("match end removes arrows",g.attack_effects.is_empty())
 arrow.queue_free();g.queue_free();await process_frame
 var failed=checks.filter(func(c):return not c.passed).size()
 print(JSON.stringify({"suite":"arrow_effect_contract","checks":checks,"failed":failed,"scope":"Cosmetic release trajectory; authoritative hit timing unchanged. Native not phone."}))
 quit(1 if failed else 0)
