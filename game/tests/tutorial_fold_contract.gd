extends SceneTree
const Codec=preload("res://scripts/checkpoint_codec.gd")
var checks=[]
func c(n,b):
 checks.append({"name":n,"passed":bool(b)})
 if not b:push_error(n)
func _initialize():call_deferred("run")
func settle():
 await process_frame;await process_frame
func touch(p,down,canceled=false,index=0):
 var e=InputEventScreenTouch.new();e.position=p;e.index=index;e.pressed=down;e.canceled=canceled;root.push_input(e);await process_frame
func tap(b):
 var p=b.get_global_rect().get_center();await touch(p,true);await touch(p,false);await settle()
func run():
 root.size=Vector2i(640,360)
 var g=load("res://main.tscn").instantiate();root.add_child(g);await settle();g.set_process(false);g.test_mode=true;g.ai_enabled=false
 g.toast_time=0;g._update_hud();g._layout_ui();await settle()
 c("fresh tutorial retains expanded onboarding",not g.tutorial_collapsed and g.tutorial_panel.is_visible_in_tree())
 var commands=g.commands.duplicate(true);var selected=g.selected.duplicate();var bank=g.economy.bank_milli(0).duplicate(true)
 var facts=g.demo_tutorial.achieved.duplicate(true);var baseline_result=Codec.capture_result(g);var baseline=baseline_result.get("data",{})
 c("pre fold strict capture is valid and nonempty",baseline_result.get("ok",false) and not baseline.is_empty())
 await tap(g.tutorial_collapse)
 c("real collapse removes full width tutorial row",g.tutorial_collapsed and not g.tutorial_panel.is_visible_in_tree())
 c("collapse is not skip or a simulation command",not g.demo_tutorial.skipped and g.demo_tutorial.achieved==facts and g.commands==commands and g.selected==selected and g.economy.bank_milli(0)==bank)
 var folded_result=Codec.capture_result(g)
 c("collapse is absent from strict saved authority",folded_result.get("ok",false) and not folded_result.get("data",{}).is_empty() and folded_result.data==baseline)
 for size in [Vector2i(640,360),Vector2i(568,320),Vector2i(320,568),Vector2i(390,844)]:
  root.size=size;g._layout_ui();await settle()
  c("progress entry fits "+str(size),g.tutorial_entry.is_visible_in_tree() and root.get_visible_rect().encloses(g.tutorial_entry.get_global_rect()) and g.tutorial_entry.size.y>=44)
  c("essential top controls fit "+str(size),root.get_visible_rect().encloses(g.pause_button.get_global_rect()) and root.get_visible_rect().encloses(g.compact_menu_button.get_global_rect()) and root.get_visible_rect().encloses(g.top_resources.get_global_rect()))
  c("rotation relayout preserves collapsed preference "+str(size),g.tutorial_collapsed and not g.tutorial_panel.is_visible_in_tree())
 root.size=Vector2i(640,360);g._layout_ui();await settle()
 var worker=g._first(0,"villager");g._select([worker.id]);g.toast_time=0;g._refresh_tutorial()
 c("real selection still records while folded",g.demo_tutorial.achieved.has("select") and not g.demo_tutorial.skipped and g.tutorial_collapsed)
 var target=g.demo_tutorial.locate(g.faction_views[0].records())
 c("ordinary gather target is current observed",target.ok)
 if target.ok:
  g._submit("order",{"ids":[worker.id],"target":target.id,"position":target.position},0)
  for i in 1000:
   g._tick(g.Rules.TICK)
   if g.demo_tutorial.achieved.has("deposit"):break
 c("normal gather and paid in cargo progress survives folding",g.demo_tutorial.achieved.has("gather") and g.demo_tutorial.achieved.has("deposit") and g.tutorial_collapsed)
 g.toast_time=0;g._refresh_tutorial();await settle()
 var p=g.tutorial_entry.get_global_rect().get_center()
 await touch(p,true);await touch(p,false,true)
 c("canceled entry touch leaves fold unchanged",g.tutorial_collapsed)
 await touch(p,true);await touch(p+Vector2(20,10),true,false,1);await touch(p,false);await touch(p+Vector2(20,10),false,false,1)
 c("second finger cancels tutorial entry",g.tutorial_collapsed)
 await tap(g.tutorial_entry)
 c("fresh entry expands current earned progress",not g.tutorial_collapsed and g.tutorial_panel.is_visible_in_tree() and g.demo_tutorial.achieved.has("deposit"))
 await tap(g.tutorial_collapse)
 g._message("出口受阻；請選取單位移開",4);g._layout_ui();await settle()
 c("folded feedback remains visible",g.tutorial_collapsed and g.toast_label.is_visible_in_tree() and not g.tutorial_label.is_visible_in_tree())
 await tap(g.guidance_detail_button)
 c("full feedback still reachable",g.context_details.visible and g.guidance_detail.text==g.toast_label.text)
 await tap(g.find_child("CloseBattleDetails",true,false));g.toast_time=0;g._refresh_tutorial();await settle()
 c("toast expiry returns folded without empty panel",g.tutorial_collapsed and not g.tutorial_panel.is_visible_in_tree())
 g._start_build("house");g.toast_time=0;g._refresh_tutorial();await settle()
 var plot=g.pointer_world;var held=g.build_preview_held;commands=g.commands.duplicate(true);bank=g.economy.bank_milli(0).duplicate(true)
 await tap(g.tutorial_entry)
 c("fold controls preserve unpaid build preview and bank",g.build_mode=="house" and g.pointer_world==plot and g.build_preview_held==held and g.commands==commands and g.economy.bank_milli(0)==bank)
 g._cancel_mode()
 if not g.tutorial_collapsed:g._toggle_tutorial_fold()
 var foe=g._spawn("scout",1,worker.pos+Vector3(1,0,0));g._update_vision();g._order(foe,"attack",worker.id);g._tick(g.Rules.TICK);g._set_stance(foe,"STOP")
 c("ordinary settled damage creates active alert fixture",not g.battle_alerts.peek(g.tick_count).is_empty())
 root.size=Vector2i(320,568);g.toast_time=0;g._update_hud();g._layout_ui();await settle()
 c("narrow alert keeps battle pause and menu visible",not g.tutorial_entry.visible and g.battle_jump_button.visible and root.get_visible_rect().encloses(g.battle_jump_button.get_global_rect()) and root.get_visible_rect().encloses(g.compact_menu_button.get_global_rect()))
 await tap(g.compact_menu_button)
 c("menu fallback progress entry reachable without new row",g.tutorial_menu_entry.is_visible_in_tree() and root.get_visible_rect().encloses(g.tutorial_menu_entry.get_global_rect()) and g.tutorial_menu_entry.size.y>=44)
 commands=g.commands.duplicate(true);selected=g.selected.duplicate();bank=g.economy.bank_milli(0).duplicate(true)
 await tap(g.tutorial_menu_entry)
 c("fallback opens lesson without orders selection or payment",not g.compact_menu.visible and not g.tutorial_collapsed and g.tutorial_panel.visible and g.commands==commands and g.selected==selected and g.economy.bank_milli(0)==bank)
 g._toggle_tutorial_fold();root.size=Vector2i(960,640);g._layout_ui();await settle()
 p=g.tutorial_entry.get_global_rect().get_center();g.test_mode=false
 await touch(p,true);g._notification(MainLoop.NOTIFICATION_APPLICATION_FOCUS_OUT);g._notification(MainLoop.NOTIFICATION_APPLICATION_FOCUS_IN);await touch(p,false)
 c("focus loss cancels held fold entry",g.tutorial_collapsed)
 g.test_mode=true
 g._skip_tutorial();g._layout_ui();await settle()
 c("explicit skip remains distinct and hides progress entry",g.demo_tutorial.skipped and not g.tutorial_entry.visible and not g.tutorial_menu_entry.visible)
 g._resume_tutorial();g._layout_ui();await settle()
 c("resume restores accessible entry without losing facts",not g.demo_tutorial.skipped and g.tutorial_entry.visible and g.demo_tutorial.achieved.has("deposit"))
 # Actual pause control, presentation toggling while paused, and actual resume.
 if g.paused:g._toggle_pause()
 if g.tutorial_collapsed:g._toggle_tutorial_fold()
 await tap(g.pause_button)
 var paused_tick=g.tick_count;commands=g.commands.duplicate(true);bank=g.economy.bank_milli(0).duplicate(true)
 c("pause control pauses before folding",g.paused and g.tutorial_entry.is_visible_in_tree())
 # Pause feedback temporarily replaces the lesson row; use its reachable top progress entry.
 await tap(g.tutorial_entry)
 c("paused fold remains paused and preserves simulation",g.paused and g.tutorial_collapsed and g.tick_count==paused_tick and g.commands==commands and g.economy.bank_milli(0)==bank)
 await tap(g.pause_button)
 c("resume control preserves chosen folded preference",not g.paused and g.tutorial_collapsed and g.tick_count==paused_tick)
 g.free();await settle()
 # Use real shell transitions, not test reset, to prove fresh-match default.
 var shell=load("res://main_menu.tscn").instantiate();root.add_child(shell);await settle()
 shell._choose_mode("practice");await settle();await tap(shell.buttons.get_node("LaunchMatchButton"))
 var original=shell.match_node;original.set_process(false);original.test_mode=true
 original._toggle_tutorial_fold();original._request_main_menu();await settle()
 c("return to main menu pauses folded match",original.paused and original.tutorial_collapsed and shell.menu_layer.visible and not original.ui.visible)
 await tap(shell.buttons.get_node("NewMatchButton"))
 c("new match still requires discard confirmation",shell.page=="confirm" and shell.match_node==original)
 await tap(shell.buttons.get_node("CancelNewMatchButton"));await tap(shell.buttons.get_node("ResumeMatchButton"))
 c("cancel new match and resume retain folded preference",shell.match_node==original and not original.paused and original.tutorial_collapsed and original.ui.visible)
 original._request_main_menu();await settle();await tap(shell.buttons.get_node("NewMatchButton"));await tap(shell.buttons.get_node("ConfirmNewMatchButton"))
 shell._choose_mode("practice");await settle();await tap(shell.buttons.get_node("LaunchMatchButton"))
 var fresh=shell.match_node;fresh.set_process(false)
 c("confirmed fresh match restores expanded onboarding",fresh!=original and not fresh.tutorial_collapsed and not fresh.demo_tutorial.skipped and fresh.tutorial_panel.is_visible_in_tree())
 var failed=checks.filter(func(x):return not x.passed).size()
 print(JSON.stringify({"suite":"tutorial_fold_contract","checks":checks,"failed":failed,"scope":"Native routed fold and unchanged tutorial facts, ordinary gather/deposit, four viewports and feedback; no physical phone performance claim."}))
 shell.free();quit(1 if failed else 0)
