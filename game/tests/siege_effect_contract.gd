extends SceneTree
const Effect=preload("res://scripts/siege_effect.gd")
var checks=[]
func check(label,ok):
	checks.append({"name":label,"passed":bool(ok)})
	if not ok:push_error(label)
func _initialize():call_deferred("run")
func run():
	var cue=Effect.make(Vector3(0,1,0),Vector3(8,0.8,0));root.add_child(cue)
	check("six bounded strike fragments",cue.get_child_count()==7 and cue.get_node("Shard5")!=null)
	var alpha=cue.get_node("Dust").material_override.albedo_color.a
	Effect.present(cue,0.2)
	check("strike fragments spread",cue.get_node("Shard0").position.x>0)
	check("dust expands and fades",cue.get_node("Dust").scale.x>0.4 and cue.get_node("Dust").material_override.albedo_color.a<alpha)
	check("dust rests on ground",is_equal_approx(cue.get_node("Dust").position.y+cue.position.y,0.12))
	check("materials remain depth tested",not cue.get_node("Shard0").material_override.no_depth_test and not cue.get_node("Dust").material_override.no_depth_test)
	var g=load("res://main.tscn").instantiate();root.add_child(g);g.set_process(false);g.test_mode=true;g.ai_enabled=false;g._test_reset();g.set_process(false);await process_frame
	var keep=g._first(0,"town_center")
	var attacker=g._spawn("siege",0,keep.pos+Vector3(4,0,0),true)
	var target=g._spawn("spearman",1,attacker.pos+Vector3(0.8,0,0),true)
	g._update_vision();var hp=target.hp;var bank=g.economy.bank_milli(0).duplicate()
	g.test_mode=false
	var released=g._release_attack(attacker,target)
	check("actual siege release accepted",released.applied)
	var repeat=g._release_attack(attacker,target)
	check("cooldown rejection creates no extra cue",not repeat.applied and g.attack_effects.size()==1)
	check("visible siege release creates cue",g.attack_effects.size()==1 and g.attack_effects[0].get("siege",false))
	var node=g.attack_effects[0].node;var start=node.get_node("Shard0").position
	g._update_attack_effects(0.2,false)
	check("pause freezes strike",node.get_node("Shard0").position==start and g.attack_effects[0].age==0)
	g._update_attack_effects(0.2,true)
	check("running advances strike",node.get_node("Shard0").position!=start)
	var endpoint=g.attack_effects[0].endpoint;target.pos+=Vector3(3,0,0)
	check("target movement cannot move stored endpoint",g.attack_effects[0].endpoint==endpoint and node.position==endpoint+Vector3(0,0.8,0))
	check("presentation cannot change hp or bank",target.hp==hp and g.economy.bank_milli(0)==bank)
	g.visible_cells[0].fill(0);g._update_attack_effects(0,false)
	check("fog revokes strike while paused",g.attack_effects.is_empty())
	g._attack_effect(attacker,target);check("unseen targets produce no cue",g.attack_effects.is_empty())
	g._update_vision();g._attack_effect(attacker,target);g._update_attack_effects(2,true)
	check("expired cue removed",g.attack_effects.is_empty())
	g._attack_effect(attacker,target);g.game_over=true;g._update_attack_effects(0,false)
	check("match end clears strike",g.attack_effects.is_empty())
	g.game_over=false;g._attack_effect(attacker,target);g._test_reset()
	check("restart clears strike",g.attack_effects.is_empty())
	var home=g._first(0,"town_center")
	var ram=g._spawn("siege",0,home.pos+Vector3(4,0,0),true)
	var building=g._spawn("house",1,ram.pos+Vector3(2,0,0),true)
	g._update_vision();g._attack_effect(ram,building)
	check("building strike appears at exposed edge",g.attack_effects.size()==1 and g.attack_effects[0].node.position.x<building.pos.x)
	g._clear_attack_effects()
	var archer=g._spawn("archer",0,home.pos+Vector3(1,0,0),true)
	g._attack_effect(archer,building)
	check("archer uses separate non siege arrow cue",g.attack_effects.size()==1 and not g.attack_effects[0].get("siege",false))
	g._update_attack_effects(g.ATTACK_EFFECT_SECONDS+0.01,true)
	check("archer cue expires at its declared lifetime",g.attack_effects.is_empty())
	check("ledger conserved",g.economy.audit().ok)
	var failed=checks.filter(func(c):return not c.passed).size()
	print(JSON.stringify({"suite":"siege_effect_contract","checks":checks,"failed":failed,"scope":"Native presentation geometry, lifecycle and fog safety; no browser rendered screenshot acceptance. Strike is cosmetic; settlement timing unchanged."}))
	cue.queue_free();g.queue_free();quit(1 if failed else 0)
