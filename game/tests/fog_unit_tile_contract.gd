extends SceneTree
const Edge=preload('res://scripts/fog_inward_edge.gd')
const Codec=preload('res://scripts/checkpoint_codec.gd')
const Restore=preload('res://scripts/checkpoint_restore.gd')
var checks=[]
func c(name,value):checks.append({'name':name,'passed':bool(value)})
func _initialize():call_deferred('run')
func run():
 var patterns=[PackedByteArray([0,0,0,0]),PackedByteArray([1,1,1,1]),PackedByteArray([2,2,2,2]),PackedByteArray([0,1,2,0]),PackedByteArray([2,1,0,2])]
 var index=0
 for states in patterns:
  var original=states.duplicate();var encoded=Edge.encode_states(states);var expected=PackedByteArray()
  for state in states:expected.append([0,128,255][state])
  c('exact CPU byte encoding '+str(index),encoded==expected)
  c('CPU encoder does not mutate source '+str(index),states==original)
  encoded[0]=77
  c('CPU output does not alias source '+str(index),states==original)
  index+=1
 var a=Edge.new();var b=Edge.new();a.initialize(2);b.initialize(2)
 c('plane dimensions exact',a.mesh.size==Vector2(2,2))
 c('inward width exact',Edge.EDGE_WIDTH==0.65)
 c('overlay height exact',is_equal_approx(a.position.y,0.115))
 c('shadow casting disabled',a.cast_shadow==GeometryInstance3D.SHADOW_CASTING_SETTING_OFF)
 c('texture dimensions metadata only',a.state_texture.get_size()==Vector2(2,2))
 c('separate instances have separate textures',a.state_texture!=b.state_texture)
 var texture=a.state_texture;var material=a.material_override
 var first=PackedByteArray([0,1,2,0])
 c('first state uploads',a.refresh(first))
 c('identical values skip upload',not a.refresh(first.duplicate()))
 c('texture material resource identities retained',a.state_texture==texture and a.material_override==material)
 first[0]=2
 c('cached state owns a copy',a.last_states[0]==0)
 c('changed state uploads',a.refresh(first))
 c('new state retained exactly',a.last_states==first)
 var replacement=PackedByteArray([1,0,1,2])
 c('same tick replacement array uploads',a.refresh(replacement))
 c('replacement content copied exactly',a.last_states==replacement)
 c('replacement same content cache hit',not a.refresh(replacement.duplicate()))
 first=replacement.duplicate()
 c('other instance remains uninitialized',b.last_states.is_empty())
 c('second instance independently uploads',b.refresh(PackedByteArray([1,1,1,1])))
 c('second refresh cannot mutate first',a.last_states==first)
 c('original rendered shader visible-only gate retained',Edge.SHADER_CODE.contains('if (current > 0.75)'))
 c('original rendered shader nearest mask retained',Edge.SHADER_CODE.contains('filter_nearest, repeat_disable'))
 c('original rendered shader cannot write depth',Edge.SHADER_CODE.contains('depth_draw_never'))
 var weak_a=weakref(a);a.free()
 c('presentation node lifecycle releases',weak_a.get_ref()==null)
 c('freeing one instance leaves other intact',is_instance_valid(b) and b.last_states==PackedByteArray([1,1,1,1]))
 b.free()
 var g=load('res://main.tscn').instantiate();root.add_child(g);g.set_process(false)
 var original_visible=g.visible_cells.duplicate(true);var original_explored=g.explored_cells.duplicate(true)
 var original_states=g.fog_render_state.duplicate()
 var before=Codec.capture_result(g)
 c('before authority capture valid',before.get('ok',false) and not before.get('data',{}).is_empty())
 g._refresh_fog();g._refresh_fog()
 var after=Codec.capture_result(g)
 c('after authority capture valid',after.get('ok',false) and not after.get('data',{}).is_empty())
 c('complete valid authority unchanged',before.get('ok',false) and after.get('ok',false) and before.get('data',{})==after.get('data',{}))
 c('all team visibility unchanged',g.visible_cells==original_visible)
 c('all team explored unchanged',g.explored_cells==original_explored)
 c('render states unchanged',g.fog_render_state==original_states)
 c('new exact unit fog footprint',g.fog.multimesh.mesh.size==Vector2(1.0,1.0))
 c('existing fog instance count unchanged',g.fog.multimesh.instance_count==g.Rules.MAP_SIZE*g.Rules.MAP_SIZE)
 c('helper follows existing current states',g.fog_inward_edge.last_states==g.fog_render_state)
 c('repeat refresh is presentation cache hit',not g.fog_inward_edge.refresh(g.fog_render_state))
 var source=FileAccess.get_file_as_string('res://scripts/game.gd')
 c('exact lattice construction source retained',Edge.BASE_TILE_Y==0.11 and source.contains('Vector3((i%Rules.MAP_SIZE)-Rules.MAP_HALF+0.5,FogInwardEdge.BASE_TILE_Y,floor(i/float(Rules.MAP_SIZE))-Rules.MAP_HALF+0.5)'))
 c('exact unit tile source bound',source.contains('plane.size=Vector2(1.0,1.0)'))
 # Actual renderer MultiMesh transform buffer is tested natively, not dummy headless.
 var visibility=[]
 for ent in g.entities:visibility.append([g._visible_to(ent,0),g._visible_to(ent,1)])
 g._refresh_fog()
 var visibility_after=[]
 for ent in g.entities:visibility_after.append([g._visible_to(ent,0),g._visible_to(ent,1)])
 c('every entity both faction visibility unchanged',visibility==visibility_after)
 var saved_states=g.fog_render_state.duplicate()
 var old_edge=weakref(g.fog_inward_edge)
 g.free()
 c('game destruction frees attached helper',old_edge.get_ref()==null)
 var fresh=load('res://main.tscn').instantiate();root.add_child(fresh);fresh.set_process(false)
 c('new game has independent initialized helper',is_instance_valid(fresh.fog_inward_edge) and fresh.fog_inward_edge.last_states==fresh.fog_render_state)
 # Synthetic stale PRESENTATION only; do not change saved authority or visibility.
 var stale=PackedByteArray();stale.resize(fresh.Rules.MAP_SIZE*fresh.Rules.MAP_SIZE);stale.fill(2)
 fresh.fog_inward_edge.refresh(stale)
 var restored=false
 if before.get('ok',false):restored=Restore.apply(fresh,before.data)
 c('valid same build paused restore succeeds',restored and fresh.paused)
 c('restore does not advance simulation',restored and fresh.tick_count==before.data.game.tick_count)
 c('restore refreshes CPU upload state while paused',restored and fresh.fog_inward_edge.last_states==saved_states)
 c('restored cached state differs from synthetic stale',restored and fresh.fog_inward_edge.last_states!=stale)
 c('paused same state refresh is cache hit',not fresh.fog_inward_edge.refresh(fresh.fog_render_state))
 var fresh_edge=weakref(fresh.fog_inward_edge);fresh.free()
 c('restored game teardown frees helper',fresh_edge.get_ref()==null)
 var failed=checks.filter(func(item):return not item.passed).size()
 print(JSON.stringify({'suite':'fog_unit_tile_contract','checks':checks,'failed':failed,'scope':'CPU encoding/cache/lifecycle and valid complete checkpoint equality. No headless GPU readback or framebuffer concealment claim; native evidence is separate.'}))
 quit(1 if failed else 0)
