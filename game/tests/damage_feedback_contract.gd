extends SceneTree
const Feedback=preload("res://scripts/damage_feedback.gd")
var checks=[]
func check(label,ok):
	checks.append({"name":label,"passed":bool(ok)})
	if not ok:push_error(label)
func _initialize():call_deferred("run")
func run():
	var holder=Node3D.new();root.add_child(holder)
	var fx=Feedback.new();fx.add(holder,Vector3.ZERO,7,false,false)
	check("damage label and depth tested billboard",fx.cues.size()==1 and fx.cues[0].node.text=="-7" and not fx.cues[0].node.no_depth_test and fx.cues[0].node.billboard==BaseMaterial3D.BILLBOARD_ENABLED)
	var origin=fx.cues[0].node.position
	fx.update(0.1,false,false,func(_p):return true)
	check("pause freezes animation",fx.cues[0].age==0 and fx.cues[0].node.position==origin)
	fx.update(0.1,true,false,func(_p):return true)
	check("running feedback rises",fx.cues[0].node.position.y>origin.y)
	fx.update(0.1,false,false,func(_p):return false)
	check("fog revocation works while paused",fx.cues.is_empty())
	fx.add(holder,Vector3.ZERO,3,true,true)
	check("lethal caption glyphs available",fx.cues[0].node.font.has_char("擊".unicode_at(0)) and fx.cues[0].node.font.has_char("倒".unicode_at(0)))
	check("lethal hit explicitly labelled",fx.cues[0].node.text=="-3\n擊倒")
	fx.update(NAN,true,false,func(_p):return true)
	check("invalid delta cannot corrupt age",fx.cues[0].age==0)
	for i in 30:fx.add(holder,Vector3(i,0,0),1,true,false)
	check("effect count bounded",fx.cues.size()==24)
	for i in 12:fx.update(0.1,true,false,func(_p):return true)
	check("expired effects removed",fx.cues.is_empty())
	fx.add(holder,Vector3.ZERO,1,true,false);fx.update(0,false,true,func(_p):return true)
	check("end clears effects",fx.cues.is_empty())
	fx.add(holder,Vector3.ZERO,0,true,false);check("zero damage ignored",fx.cues.is_empty())
	var g=load("res://main.tscn").instantiate();root.add_child(g);g.set_process(false);g.test_mode=true;g.ai_enabled=false;g._test_reset();g.set_process(false);await process_frame
	var attacker=g._first(0,"scout")
	var defender=g._spawn("spearman",1,attacker.pos+Vector3(0.8,0,0),true)
	g._set_stance(attacker,"STOP");g._set_stance(defender,"STOP");g._update_vision()
	var hp=defender.hp;var bank=g.economy.bank_milli(0).duplicate()
	var released=g._release_attack(attacker,defender)
	check("actual visible attack released",released.applied)
	check("release alone creates no damage number",g.damage_feedback.cues.is_empty())
	g._tick(g.Rules.TICK)
	var loss=hp-defender.hp
	check("settlement produces actual hp loss",loss>0)
	check("number equals settled loss",g.damage_feedback.cues.size()==1 and g.damage_feedback.cues[0].node.text=="-%d" % loss)
	var saved=g.damage_feedback.cues[0].origin
	defender.pos+=Vector3(10,0,0)
	g.damage_feedback.update(0.1,true,false,func(_p):return true)
	check("effect never follows hidden authority target",g.damage_feedback.cues[0].origin==saved)
	g.damage_feedback.clear();g.visible_cells[0].fill(0)
	g._record_damage_feedback(defender,5)
	check("unseen enemy damage produces no effect",g.damage_feedback.cues.is_empty())
	g._update_vision();g._record_damage_feedback(attacker,9999)
	check("overkill capped to actual remaining hp",g.damage_feedback.cues.size()==1 and g.damage_feedback.cues[0].node.text=="-%d\n擊倒" % attacker.hp)
	check("presentation never mutates hp or bank",defender.hp==hp-loss and g.economy.bank_milli(0)==bank)
	g._test_reset();check("new match clears feedback",g.damage_feedback.cues.is_empty())
	check("ledger conserved",g.economy.audit().ok)
	var failed=checks.filter(func(c):return not c.passed).size()
	print(JSON.stringify({"suite":"damage_feedback_contract","checks":checks,"failed":failed,"scope":"Real native attack settlement and presentation node properties; no rendered screenshot or physical device acceptance"}))
	fx.clear();holder.queue_free();g.queue_free();quit(1 if failed else 0)
