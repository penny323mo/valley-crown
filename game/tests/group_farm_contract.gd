extends SceneTree
var checks=[]
func check(label,ok):
 checks.append({"name":label,"passed":bool(ok)})
 if not ok:push_error(label)
func _initialize():call_deferred("run")
func run():
 var g=load("res://main.tscn").instantiate();root.add_child(g);g.test_mode=true;g.ai_enabled=false;g._test_reset();g.set_process(false);await process_frame
 var a=g._spawn("farm",0,Vector3.ZERO,true)
 var b=g._spawn("farm",0,Vector3(4,0,0),true)
 var occupied=g._spawn("farm",0,Vector3(-4,0,0),true)
 var owner=g._spawn("villager",0,Vector3(-3,0,1),true)
 g.economy.assign_farm("group-owner",owner.id,occupied.id)
 var first=g._spawn("villager",0,Vector3(1,0,3),true)
 var second=g._spawn("villager",0,Vector3(2,0,3),true)
 var extra=g._spawn("villager",0,Vector3(3,0,3),true)
 var soldier=g._spawn("spearman",0,Vector3(4,0,3),true)
 g._update_vision(false);g._publish_faction_views()
 var previous=extra.state;var prior_target=extra.target
 g._execute({"type":"order","team":0,"ids":[second.id,extra.id,first.id,first.id,soldier.id],"target":a.id,"position":a.pos,"farm_gather":true})
 check("stable first worker owns tapped farm",g.economy.farm_view(a.id).worker_id==first.id)
 check("second worker owns vacant neighboring farm",g.economy.farm_view(b.id).worker_id==second.id)
 check("existing farmer is not evicted",g.economy.farm_view(occupied.id).worker_id==owner.id)
 check("surplus worker preserves previous state and target",extra.state==previous and extra.target==prior_target)
 check("soldier does not receive farm work",soldier.state=="idle")
 check("first worker has normal gather target",first.target==a.id)
 check("second worker has normal gather target",second.target==b.id)
 var near=g._spawn("farm",0,Vector3(0,0,4),true)
 var enemy=g._spawn("farm",1,Vector3(0,0,-4),true)
 var unfinished=g._spawn("farm",0,Vector3(0,0,6),false)
 var far=g._spawn("farm",0,Vector3(12,0,0),true)
 g._update_vision(false);g._publish_faction_views()
 g._execute({"type":"order","team":0,"ids":[extra.id],"target":a.id,"position":a.pos,"farm_gather":true})
 check("single-worker tap keeps existing rejection semantics",extra.target==prior_target and g.economy.farm_view(near.id).worker_id==-1)
 g._execute({"type":"order","team":0,"ids":[extra.id,soldier.id],"target":a.id,"position":a.pos,"farm_gather":true})
 check("group tap of occupied anchor fills neighboring vacancy",g.economy.farm_view(near.id).worker_id==extra.id)
 check("enemy farm not assigned",g.economy.farm_view(enemy.id).get("worker_id",-1)==-1)
 check("unfinished farm not assigned",g.economy.farm_view(unfinished.id).get("worker_id",-1)==-1)
 check("distant farm not assigned",g.economy.farm_view(far.id).get("worker_id",-1)==-1)
 var failed=checks.filter(func(c):return not c.passed).size()
 print(JSON.stringify({"suite":"group_farm_contract","checks":checks,"failed":failed,"scope":"controlled authoritative group orders, not touch or public deployment"}));g.queue_free();quit(1 if failed else 0)
