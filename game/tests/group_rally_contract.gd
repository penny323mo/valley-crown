extends SceneTree
var checks=[]
func check(label,ok):
 checks.append({"name":label,"passed":bool(ok)})
 if not ok:push_error(label)
func flush(g):
 var batch=g.commands.duplicate(true);g.commands.clear()
 for command in batch:g._execute(command)
func _initialize():call_deferred("run")
func run():
 var g=load("res://main.tscn").instantiate();root.add_child(g);g.test_mode=true;g.ai_enabled=false;g._test_reset();g.set_process(false);await process_frame
 var keep=g._first(0,"town_center")
 var a=g._spawn("barracks",0,keep.pos+Vector3(6,0,6),true)
 var b=g._spawn("range",0,keep.pos+Vector3(-6,0,6),true)
 g._navigation_rebuild();g._update_vision(false);g._publish_faction_views()
 var point=g._nearest_free(keep.pos+Vector3(5,0,0),3,0)
 check("visible controlled empty destination exists",point!=Vector3.INF)
 g._select([]);g._select_military_producers()
 check("explicit shortcut selects both military producers only",g.selected==[a.id,b.id])
 g._start_group_rally("advance")
 check("group captured in stable ID order",g.rally_group==[a.id,b.id] and g.rally_mode=="advance")
 g._submit_group_rally(point)
 check("one ordinary command per selected producer",g.commands.size()==2 and g.commands[0].type=="rally" and g.commands[1].type=="rally")
 check("mode clears after map destination",g.rally_group.is_empty() and g.rally_building==-1)
 flush(g)
 check("both selected buildings have advance rally",a.get("rally_mode","")=="advance" and b.get("rally_mode","")=="advance" and a.rally_point==b.rally_point)
 check("unselected town center unchanged",not keep.has("rally_point"))
 var spear=g._spawn("spearman",0,keep.pos+Vector3(3,0,3),true)
 var archer=g._spawn("archer",0,keep.pos+Vector3(4,0,3),true)
 g._apply_newborn_rally(spear,a);g._apply_newborn_rally(archer,b)
 check("different troop types inherit ordinary advance orders",g.commands.size()==2 and g.commands[0].type=="advance" and g.commands[1].type=="advance")
 flush(g)
 check("both troops enter advance mode",spear.mode=="ADVANCE" and archer.mode=="ADVANCE")
 g._select([a.id,b.id]);g._start_group_rally();g._cancel_mode()
 check("cancel creates no commands and clears snapshot",g.commands.is_empty() and g.rally_group.is_empty())
 g._select([a.id,keep.id]);g._start_group_rally()
 check("civilian producer mixed selection rejected",g.rally_group.is_empty() and g.rally_building==-1)
 g._select([a.id,spear.id]);g._start_group_rally()
 check("unit mixed selection rejected",g.rally_group.is_empty())
 g._select([a.id,b.id]);g.paused=true;g._start_group_rally();g.paused=false
 check("paused setup rejected",g.rally_group.is_empty())
 g._start_group_rally();g._submit_group_rally(Vector3(999,0,999));flush(g)
 check("invalid destination preserves prior rallies",a.rally_mode=="advance" and b.rally_mode=="advance")
 g._select([a.id,b.id]);g._start_group_rally();b.team=1;g._submit_group_rally(point);flush(g)
 check("ownership changed before execution rejects stale member",b.rally_mode=="advance" and a.rally_mode=="move")
 var failed=checks.filter(func(c):return not c.passed).size()
 print(JSON.stringify({"suite":"group_rally_contract","checks":checks,"failed":failed,"build":g.Rules.BUILD_ID,"scope":"controlled UI handlers and normal authority, not phone touch or deployment"}));g.queue_free();quit(1 if failed else 0)
