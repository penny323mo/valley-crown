extends SceneTree
const Risk=preload("res://scripts/ai_worker_route_risk.gd")
const Path=preload("res://scripts/bounded_grid_pathfinder.gd")
var checks=[]
func check(n,x):checks.append({"name":n,"ok":bool(x)})
func _initialize():call_deferred("run")
func run():
 var enemy={"id":1,"team":0,"alive":true,"remembered":false,"kind":"archer","category":"unit","pos":Vector3.ZERO,"built":true}
 var start=Vector2i(34,40);var origin=Vector3(-5.5,0,.5);var a={1:enemy}
 var before=a.duplicate(true);var edges=Risk.blocked_edges(a,1,.35,start,origin)
 check("current hostile attack reach creates detached edges",not edges.is_empty())
 check("no current enemies leaves legacy search unconstrained",Risk.blocked_edges({},1,.35,start,origin).is_empty())
 for patch in [{"remembered":true},{"alive":false},{"team":1}]:
  var e=enemy.duplicate();e.merge(patch,true);check("excluded record "+str(patch),Risk.blocked_edges({1:e},1,.35,start,origin).is_empty())
 var tower=enemy.duplicate();tower.kind="tower";tower.category="building"
 check("observed built tower contributes original range",not Risk.blocked_edges({1:tower},1,.35,start,origin).is_empty())
 tower.built=false
 check("unbuilt tower cannot contribute attack reach",Risk.blocked_edges({1:tower},1,.35,start,origin).is_empty())
 tower.built=true;tower.category="resource"
 check("malformed resource tower is not an attacking building",Risk.blocked_edges({1:tower},1,.35,start,origin).is_empty())
 check("outside segment cannot enter attack circle",not Risk.segment_allowed(a,1,.35,Vector3(-5,0,0),Vector3(-4,0,0)))
 check("inside circle may escape outward",Risk.segment_allowed(a,1,.35,Vector3(-4,0,0),Vector3(-5,0,0)))
 check("inside circle cannot move deeper",not Risk.segment_allowed(a,1,.35,Vector3(-4,0,0),Vector3(-3,0,0)))
 check("offcentre first movement is assessed from actual position",not Risk.segment_allowed(a,1,.35,Vector3(-4.9,0,0),Vector3(-4.5,0,.5)))
 var second=enemy.duplicate();second.id=2;second.pos=Vector3(-7,0,0)
 check("overlapping circles cannot erase each others constraints",not Risk.segment_allowed({1:enemy,2:second},1,.35,Vector3(-4,0,0),Vector3(-5,0,0)))
 check("observation insertion order yields identical edges",Risk.blocked_edges({1:enemy,2:second},1,.35,start,origin)==Risk.blocked_edges({2:second,1:enemy},1,.35,start,origin))
 var grid=AStarGrid2D.new();grid.region=Rect2i(0,0,80,80);grid.update()
 var baseline=Path.search(grid,start,Vector2i(46,40),4096)
 var result=Path.search(grid,start,Vector2i(46,40),4096,edges)
 check("bounded existing search can route around observed threat",result.status==Path.FOUND and result.expanded<=4096 and result.path.size()>baseline.path.size())
 check("zero expansion ceiling is not increased",Path.search(grid,start,Vector2i(46,40),0,edges).status==Path.LIMIT_REACHED)
 check("risk analysis preserves observations and shared occupancy",a==before and not grid.is_point_solid(Vector2i(40,40)))
 var union={Vector4i(34,40,34,41):true};union.merge(edges,true)
 check("existing traffic constraint survives union",union.has(Vector4i(34,40,34,41)))
 var index=Risk.indexed(a,1,.35,start,origin)
 var lazy=Path.search(grid,start,Vector2i(46,40),4096,{}, {},Callable(index,"allows"))
 check("indexed search exactly matches eager result",lazy==result)
 check("indexed risk preserves zero expansion ceiling",Path.search(grid,start,Vector2i(46,40),0,{}, {},Callable(index,"allows")).status==Path.LIMIT_REACHED)
 var blockers={Vector4i(34,40,34,41):true}
 var old_union=blockers.duplicate();old_union.merge(edges,true)
 check("indexed risk unions original traffic without mutation",Path.search(grid,start,Vector2i(46,40),4096,blockers,{},Callable(index,"allows"))==Path.search(grid,start,Vector2i(46,40),4096,old_union) and blockers.size()==1)
 var empty_index=Risk.indexed({},1,.35,start,origin)
 check("empty index leaves legacy result exact",Path.search(grid,start,Vector2i(46,40),4096,{}, {},Callable(empty_index,"allows"))==baseline)
 var original_buckets=index.buckets.duplicate(true)
 a[1].pos=Vector3(30,0,30)
 check("index is detached from later observation mutation",index.buckets==original_buckets and Path.search(grid,start,Vector2i(46,40),4096,{}, {},Callable(index,"allows"))==result)
 check("new index uses same tick changed observations",Risk.indexed(a,1,.35,start,origin).buckets!=original_buckets)
 var shared=Risk.indexed(before,1,.35,start,origin)
 var canonical=shared.for_origin(start,Vector3(start.x-39.5,0,start.y-39.5))
 var cached_result=Path.search(grid,start,Vector2i(46,40),4096,{}, {},Callable(canonical,"allows"))
 check("batch canonical memo matches uncached eager route",cached_result==result)
 var offstart=Vector2i(35,40);var offorigin=Vector3(-4.9,0,.01)
 var offquery=shared.for_origin(offstart,offorigin)
 var offedges=Risk.blocked_edges(before,1,.35,offstart,offorigin)
 var offresult=Path.search(grid,offstart,Vector2i(46,40),4096,{}, {},Callable(offquery,"allows"))
 check("offcentre first edges never reuse canonical cache",offresult==Path.search(grid,offstart,Vector2i(46,40),4096,offedges))
 check("offcentre query cannot poison another start",Path.search(grid,start,Vector2i(46,40),4096,{}, {},Callable(canonical,"allows"))==cached_result)
 check("fresh drain index has no prior canonical memo",Risk.indexed(before,1,.35,start,origin).canonical_edges.is_empty())
 check("shared memo stays bounded by map outgoing edges",shared.canonical_edges.size()<=80*80*8)
 var failed=checks.filter(func(c):return not c.ok).size();print(JSON.stringify({"suite":"ai_worker_route_risk_contract","checks":checks,"failed":failed,"scope":"Detached observation-only edge risk and bounded search; actual AI continuation separately evidenced"}));quit(1 if failed else 0)
