+# Geometry-identical paint study. Pigment broad cut planes in vertex RGB,
+# preserving silhouette, rays, UVs, normal vectors and the same material.
+static func _quarry_tint(pos: Vector3, normal: Vector3, crest: float, stage: int, style: int) -> Color:
+	var axis: Vector2 = [Vector2(.72,.69),Vector2(.96,.28),Vector2(.33,.94)][style]
+	var projected := Vector2(pos.x,pos.z).dot(axis)
+	var cut: float = [.0,.54,.36,.21][stage]
+	var seam_height := pos.y/crest - projected*.32 - cut
+	var ledge := smoothstep(-.09,.11,seam_height)
+	var exposed := smoothstep(.10,.85,normal.y)*ledge
+	var seam := maxf(0.0,1.0-absf(seam_height)/.20)
+	var rind := Color(.92,.90,.86).lerp(Color(.80,.81,.77),seam*.56)
+	var quarry := rind.lerp(Color(1.0,.99,.94),exposed)
+	return quarry
